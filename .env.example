# SUGI ASAYAKE — орчны тохиргооны ЖИШЭЭ файл
#
# ЭНЭ ФАЙЛД ЖИНХЭНЭ НУУЦ ҮГ БИЧИХГҮЙ. Энэ файл GitHub дээр байдаг.
# Шинэ компьютер дээр:  cp .env.example .env   (PowerShell: copy .env.example .env)
# Дараа нь .env дотор жинхэнэ утгуудыг бөглөнө. .env нь .gitignore-д байгаа
# тул хэзээ ч GitHub руу орохгүй.
#
# Жинхэнэ утгуудыг хаанаас авах вэ:
#   - Хамгийн хялбар: хуучин лаптопынхаа .env файлыг USB/чатаар хуулж авах
#   - Эсвэл доорх мөр бүрийн тайлбарт бичсэн газраас

# ─────────────────────────────────────────────────────────────
# 1. ЗААВАЛ — эдгээргүйгээр сайт огт ажиллахгүй
# ─────────────────────────────────────────────────────────────

# Aiven MySQL. ХОЁР ЛАПТОП НЭГ ИЖИЛ DATABASE ашигладаг тул энэ утга
# хоёр лаптоп дээр ЯГ ИЖИЛ байх ёстой. Тиймээс шинэ лаптоп дээр бааз
# суулгах шаардлагагүй — 937 бараа, захиалга бүгд шууд харагдана.
# Хаанаас: Aiven Console → sugi-asayake-db → Connection information
DATABASE_URL=mysql://avnadmin:НУУЦҮГ@sugi-asayake-db-project-4b75.h.aivencloud.com:25861/defaultdb?ssl-mode=REQUIRED

# Нэвтрэх сешн (cookie) шифрлэх түлхүүр. Локал хөгжүүлэлтэд дурын урт
# тэмдэгт мөр болно. Production дээр ЗААВАЛ санамсаргүй урт утга байх ёстой.
JWT_SECRET=ЭНД-УРТ-САНАМСАРГҮЙ-ТЭМДЭГТ-БИЧ

# Энэ имэйлээр бүртгүүлсэн хэрэглэгч автоматаар admin эрх авна.
OWNER_EMAIL=эзэмшигчийн-имэйл@example.com

# Cloudflare R2 (барааны зургууд). Хоёр лаптоп нэг ижил bucket ашиглана.
# Хаанаас: Cloudflare dashboard → R2 → Manage R2 API Tokens
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://ДАНСНЫ-ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://pub-HASH.r2.dev

# Локал сервер ямар порт дээр асах вэ.
PORT=3000

# Интеграцийн нууц үгсийг (Brevo, QPay г.м.) баазад шифрлэж хадгалдаг түлхүүр.
# ЯГ 64 тэмдэгт hex байх ёстой. Шинээр үүсгэх бол PowerShell дээр:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Хуучин лаптопынхтай ИЖИЛ байх ёстой — өөр байвал өмнө хадгалсан
#    интеграцийн түлхүүрүүдийг тайлж уншиж чадахгүй.
INTEGRATIONS_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# 2. СОНГОЛТТОЙ — байхгүй бол тухайн функц л унтарна, сайт ажиллана
# ─────────────────────────────────────────────────────────────

# Утасны дугаар SMS-ээр баталгаажуулах (бүртгэл + нууц үг сэргээх).
# ⚠️ Байхгүй бол бүртгэл хийх үед ШУУД алдаа өгнө (чимээгүй алгасдаггүй).
#    Зөвхөн дэлгүүрийг үзэх/засах бол хоосон байж болно.
VERIFY_MN_API_KEY=

# Алдаа хянах (Honeybadger). Байхгүй бол чимээгүй унтарна.
HONEYBADGER_API_KEY=
VITE_HONEYBADGER_API_KEY=
HONEYBADGER_PERSONAL_AUTH_TOKEN=

# Имэйл/SMS илгээх (Brevo). Байхгүй бол имэйл серверийн лог руу бичигдэнэ.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SUGI ASAYAKE
BREVO_SMS_SENDER=SUGI
# Олон нийтэд SMS кампанит ажил илгээхийг зөвшөөрөх (анхдагч: унтраалттай)
SMS_CAMPAIGNS_ENABLED=

# QPay төлбөр. Жинхэнэ merchant гэрээ хийгдээгүй тул одоогоор хоосон.
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_ENVIRONMENT=

# Hosting дээр гарсны дараа QPay callback-д ашиглах бодит хаяг.
PUBLIC_BASE_URL=

# /admin руу орохдоо царайгаар баталгаажуулах шалгалт.
# Локал дээр тест хийхэд саад болвол 0 болгож унтраа.
ADMIN_FACE_GATE_ENABLED=1
ADMIN_FACE_LIVENESS_ENFORCED=

# Aiven-ий CA сертификат (PEM). Байвал баазын серверийн сертификатыг
# шалгана; байхгүй бол холболт шифрлэгдсэн ч сертификат шалгагдахгүй
# (сервер асахад анхааруулга бичнэ).
# Хаанаас: Aiven Console → sugi-asayake-db → Overview → "CA certificate"
DATABASE_CA_CERT=
# эсвэл файлын зам (файлыг git-д commit хийхгүй):
# DATABASE_CA_CERT_PATH=./aiven-ca.pem
