{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    // 2026-09-12: no target used to mean ES5 for type-checking, so iterating
    // a Map or Set needed Array.from() workarounds and top-level await in
    // scripts could not be checked at all. Nothing is emitted from here
    // (Vite/esbuild compile with their own targets), so this only widens
    // what the checker accepts.
    "target": "ES2022",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    // TypeScript flags `baseUrl` as deprecated ahead of its removal in a
    // future major version -- this repo still relies on it for the @/ and
    // @shared/ path aliases below, matching Vite's own resolve.alias in
    // vite.config.ts, so silencing the warning now rather than migrating
    // off it (a real migration is its own task, not a one-line fix). "5.0"
    // is the value this project's actual installed TypeScript (5.9.3)
    // accepts -- VS Code's editor panel may suggest "6.0" instead if its
    // bundled/global TS version differs from the workspace's; if the
    // Problems panel still shows the notice after this, switch VS Code to
    // "Use Workspace Version" for TypeScript (Ctrl+Shift+P -> "TypeScript:
    // Select TypeScript Version") rather than bumping this value.
    "ignoreDeprecations": "5.0",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
